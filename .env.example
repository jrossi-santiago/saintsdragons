# Saints & Dragons — every environment variable the site reads.
# Copy to .env for local work (tools/dev-server.js loads it), and set the
# same names in Vercel's project settings for preview and production.

# ---------------------------------------------------------------- database
# Supabase, from Project Settings -> Database -> Connection string, and it
# has to be the right one of the three on that page:
#
#   Transaction pooler, port 6543            <- this one
#     postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Not "Direct connection" (db.<ref>.supabase.co) — it is IPv6-only on new
# projects and Vercel's functions are IPv4, so it simply will not connect.
# Not "Session pooler" (5432) — a function that runs for 300ms should not
# hold a connection open.
#
# Replace [YOUR-PASSWORD] with the database password. If you did not save it,
# reset it on the same page; it is not the same as your Supabase account
# password. A password with @ : / ? # in it must be percent-encoded.
#
# Any non-Supabase Postgres works too — a local one for development:
#   postgresql://localhost:5432/saintsdragons
DATABASE_URL=

# ------------------------------------------------------------------- email
# Resend. Without it, login links are printed to the server log instead of
# being sent — fine locally, useless in production.
RESEND_API_KEY=
EMAIL_FROM="Saints & Dragons <hello@saintsanddragons.com>"
# Optional: where a reply to a login email goes.
EMAIL_REPLY_TO=

# ------------------------------------------------------------------ stripe
# Test keys (sk_test_…) everywhere except production.
STRIPE_SECRET_KEY=
# The $6/month recurring price, not the product: price_…
STRIPE_PRICE_ID=
# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard. Without it the webhook refuses every payload, which is
# the right way round: an unverified body is not worth trusting.
STRIPE_WEBHOOK_SECRET=

# -------------------------------------------------------------------- site
# The public origin, no trailing slash. Login links and Stripe's return URLs
# are built from it, so a wrong value here sends readers to the wrong place.
#
# On Vercel, set it on **Production only** — the domain readers actually
# type. Preview deployments fall back to their own VERCEL_URL, so a login
# link made while testing a branch opens that branch and not the live site.
SITE_URL=http://localhost:8000
