# Saints & Dragons — every environment variable the site reads.
# Copy to .env for local work (tools/dev-server.js loads it), and set the
# same names in Vercel's project settings for preview and production.

# ---------------------------------------------------------------- database
# The Neon connection string, pooled endpoint. Anything that is not a
# *.neon.tech host is driven through node-postgres instead, which is how a
# local Postgres works for development:
#   postgresql://localhost:5432/saintsdragons
DATABASE_URL=

# ------------------------------------------------------------------- email
# Resend. Without it, login links are printed to the server log instead of
# being sent — fine locally, useless in production.
RESEND_API_KEY=
EMAIL_FROM="Saints & Dragons <hello@saintsanddragons.com>"
# Optional: where a reply to a login email goes.
EMAIL_REPLY_TO=

# ------------------------------------------------------------------ stripe
# Test keys (sk_test_…) everywhere except production.
STRIPE_SECRET_KEY=
# The $6/month recurring price, not the product: price_…
STRIPE_PRICE_ID=
# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard. Without it the webhook refuses every payload, which is
# the right way round: an unverified body is not worth trusting.
STRIPE_WEBHOOK_SECRET=

# -------------------------------------------------------------------- site
# The public origin, no trailing slash. Login links and Stripe's return URLs
# are built from it, so a wrong value here sends readers to the wrong place.
SITE_URL=http://localhost:8000
